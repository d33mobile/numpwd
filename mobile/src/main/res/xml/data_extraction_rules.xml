<?xml version="1.0" encoding="utf-8"?>
<!-- Only the key name list is backed up or transferred; it holds no secrets. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="key_names.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="key_names.xml" />
    </device-transfer>
</data-extraction-rules>
