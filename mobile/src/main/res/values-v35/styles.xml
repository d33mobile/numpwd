<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Opt out of the edge-to-edge enforcement of targetSdk 35. Android 16 ignores the
         opt-out at targetSdk 36; SystemBarInsets keeps the content out of the bars there. -->
    <style name="NumPwd.App" parent="NumPwd">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
